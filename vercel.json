{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/", "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }], "destination": "/SKILL.md" },
    { "source": "/", "missing": [{ "type": "header", "key": "accept", "value": ".*text/html.*" }], "destination": "/SKILL.md" },
    { "source": "/((?!SKILL\\.md$|references/|assets/|_app/).*)", "destination": "/app.html" }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Vary", "value": "Accept" }] },
    { "source": "/(.*)\\.md", "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }] },
    { "source": "/assets/(.*)\\.(ts|tsx)", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] }
  ]
}
